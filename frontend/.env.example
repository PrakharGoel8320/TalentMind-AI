# Frontend environment variables.
#
# Local dev: copy this file to `frontend/.env.local` and adjust as needed.
# Production (Vercel): set NEXT_PUBLIC_API_URL in
#   Project -> Settings -> Environment Variables, then REDEPLOY.
#
# IMPORTANT: NEXT_PUBLIC_* variables are inlined into the bundle at BUILD time,
# not read at runtime. Changing this value requires a new deployment/build to
# take effect.
#
# Point this at your deployed backend. Must be HTTPS in production (an http://
# URL is blocked as mixed content by an https:// site). The app appends
# `/api/v1` automatically if it is missing, so both of these work:
#   NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
#   NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

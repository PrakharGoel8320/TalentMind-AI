NEO4J_PASSWORD=CHANGE_ME
UPLOAD_MAX_PDF_MB=5
MAX_AGENT_STEPS=8
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_MODEL_NAME=gemma3:4b
LLM_PROVIDER=mock
LLM_MODEL=gemma3:4b
EMAIL_MODE=mock

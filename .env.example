# =============================================================================
# TalentMind AI — Environment template (safe placeholders only)
# Copy to backend/.env for local development:
#   cp .env.example backend/.env   (Linux/macOS)
#   copy .env.example backend\.env (Windows)
# Docker Compose reads a root .env for postgres/neo4j overrides.
# =============================================================================

# --- Required: Database ---
# SQLite (local demo):
DATABASE_URL=sqlite+aiosqlite:///./test.db
# Postgres (docker/production example):
# DATABASE_URL=postgresql+asyncpg://talentmind:changeme@localhost:5432/talentmind_db

# --- Required: Authentication ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Required: CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Required by Settings (defaults OK for local demo) ---
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# --- Upload limits ---
UPLOAD_MAX_PDF_MB=5

# --- Agent limits ---
MAX_AGENT_STEPS=8

# --- Legacy Ollama/Gemma settings (reserved; agent uses LLM_* below) ---
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_MODEL_NAME=gemma3:4b

# --- LLM provider for LangGraph agent ---
# Options: mock (default, no LLM required), ollama, openai
LLM_PROVIDER=mock
LLM_MODEL=gemma3:4b
# OPENAI_API_KEY=sk-your-key-here

# --- Email (safe default: mock) ---
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend (only NEXT_PUBLIC_* is exposed to browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Docker Compose overrides (optional) ---
POSTGRES_USER=talentmind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=talentmind_db
NEO4J_AUTH=neo4j/changeme

# --- Optional: retrieval/ranking tuning (prefix-based) ---
# RETRIEVAL_MODEL_NAME=all-MiniLM-L6-v2
# RANKING_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
